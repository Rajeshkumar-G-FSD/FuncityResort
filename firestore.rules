rules_version = '2';

// Fun City Resort — Cloud Firestore security rules
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- helpers ----------------------------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function nonEmpty(v) {
      return v is string && v.size() > 0;
    }

    function isISODate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A manual room block = one room, one night. Shape is tightly bounded so
    // an unauthenticated write can only ever "block a real room on a real day".
    function validRoomBlock(d) {
      return d.keys().hasOnly(['roomNumber', 'date', 'note', 'createdAt'])
             && d.keys().hasAll(['roomNumber', 'date', 'createdAt'])
             && d.roomNumber is string && d.roomNumber.size() >= 1 && d.roomNumber.size() <= 8
             && isISODate(d.date)
             && d.createdAt is timestamp
             && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    // Shape + value validation for a booking created by the website.
    // Deliberately lenient on formats (dates as strings, numbers as `number`,
    // timestamps as `timestamp`) so legitimate writes are never rejected —
    // the important guards are: status must be 'pending', amounts sane,
    // core fields present and non-empty.
    function validNewBooking(d) {
      return d.keys().hasAll([
               'roomTypeId','roomTypeTitle','roomNumber',
               'checkIn','checkOut','nights',
               'guests','guestName','guestEmail','guestPhone',
               'subtotal','tax','total',
               'paymentOption','paidAmount','balanceDue','transactionId','paymentMethod',
               'bookingRef','status','createdAt'
             ])
             && nonEmpty(d.roomTypeId)
             && nonEmpty(d.roomTypeTitle)
             && nonEmpty(d.roomNumber)
             && nonEmpty(d.checkIn)
             && nonEmpty(d.checkOut)
             && d.checkOut > d.checkIn
             && d.nights is number && d.nights >= 1 && d.nights <= 60
             && d.guests is map
             && d.guests.adults is number && d.guests.adults >= 1 && d.guests.adults <= 20
             && d.guests.children is number && d.guests.children >= 0 && d.guests.children <= 12
             && nonEmpty(d.guestName) && d.guestName.size() <= 120
             && nonEmpty(d.guestEmail) && d.guestEmail.size() <= 200
             && nonEmpty(d.guestPhone) && d.guestPhone.size() <= 30
             && d.subtotal is number && d.subtotal >= 0
             && d.tax is number && d.tax >= 0
             && d.total is number && d.total >= 0 && d.total <= 5000000
             && (d.paymentOption == '10' || d.paymentOption == '40' || d.paymentOption == 'custom')
             && d.paidAmount is number && d.paidAmount >= 0 && d.paidAmount <= d.total
             && d.balanceDue is number && d.balanceDue >= 0 && d.balanceDue <= d.total
             && nonEmpty(d.transactionId) && d.transactionId.size() <= 80
             && nonEmpty(d.paymentMethod)
             && nonEmpty(d.bookingRef)
             && d.status == 'pending'
             && d.createdAt is timestamp;
    }

    // Booking status change (admin panel).
    //
    // NOTE: this does NOT require request.auth, because the admin panel can run
    // on a local password gate when Firebase Authentication is not enabled for
    // the project. It is still safe: ONLY `status` and `statusUpdatedAt` may
    // change (price / dates / guest details cannot be tampered with), and
    // status must be one of the three allowed values.
    // After you enable Email/Password auth, harden this by adding
    // `isSignedIn() &&` to the front of the return.
    function validStatusUpdate() {
      return request.resource.data.status in ['pending', 'confirmed', 'cancelled']
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'statusUpdatedAt']);
    }

    /* ---------------------------- bookings ---------------------------- */
    // read  : public — guests query pending/confirmed rows to compute live
    //         room availability; the admin panel streams every row.
    // create: anyone, but only a well-formed booking with status 'pending'.
    // update: only the status fields may change (admin panel).
    // delete: never (cancel via status instead).
    match /bookings/{bookingId} {
      allow read:   if true;
      allow create: if validNewBooking(request.resource.data);
      allow update: if validStatusUpdate();
      allow delete: if false;
    }

    /* --------------------------- roomBlocks -------------------------- */
    // Manual room blocks made from the admin calendar.
    // read  : public — guests need it to compute availability.
    // create: anyone, but only a tightly-shaped one-room-one-night doc.
    // delete: anyone — "unblock" from the admin calendar (local admin gate).
    // update: never — blocks are create/delete only.
    // Harden create + delete with `isSignedIn() &&` after enabling Firebase Auth.
    match /roomBlocks/{blockId} {
      allow read:   if true;
      allow create: if validRoomBlock(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    /* --------------------- deny everything else ---------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
